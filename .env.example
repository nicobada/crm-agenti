# ==============================================================================
# CRM Agenti & Provvigioni - Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_agenti?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# WARNING: Change JWT_SECRET to a cryptographically secure random string in production!
# e.g.: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET="dev-jwt-secret-min-32-chars-for-security-key-2026"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. Backend API Service (NestJS)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
WEB_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Document Storage (AWS S3 / MinIO S3-Compatible / Local Fallback)
# - Leave S3_ENDPOINT empty and credentials default to use local filesystem fallback (./uploads)
# - For MinIO local development with Docker, configure below:
# ------------------------------------------------------------------------------
S3_REGION="eu-west-1"
S3_BUCKET="crm-documents"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio123"
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 5. Frontend Client (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
