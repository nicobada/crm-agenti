# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
dist/
build/
out/
packages/prisma/generated/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment variables & secrets (Never commit secrets)
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
# Allow example environment files
!.env.example
!**/.env.example

# Uploads & local storage (preserve .gitkeep only)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Scratch & Temporary files
scratch/
**/scratch/
*.tmp
*.temp

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
